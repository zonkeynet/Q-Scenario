{
  "id": "starter.secret_redactor",
  "name": "Secret Redactor",
  "summary": "Redacts API keys, private key blocks, cards, emails and phone-like tokens.",
  "category": "OPSEC utility",
  "risk": "LOW",
  "files": {
    "manifest.json": {
      "schema": "qp1ng.tool.v1",
      "id": "starter.secret_redactor",
      "name": "Secret Redactor",
      "version": "0.1.0",
      "author": "local",
      "category": "workspace",
      "description": "Redacts API keys, private key blocks, cards, emails and phone-like tokens.",
      "icon": {
        "type": "auto",
        "glyph": "terminal",
        "accent": "cyan"
      },
      "permissions": {
        "sandboxExecution": true,
        "workspaceRead": false,
        "workspaceWrite": false,
        "network": false,
        "keyboardShortcut": true,
        "chatBubble": true,
        "androidAction": false,
        "securityLab": false
      },
      "network": null,
      "securityLab": null,
      "inputs": [
        {
          "name": "selection",
          "type": "template",
          "value": "{{selection.text}}",
          "required": false
        }
      ],
      "risk": null,
      "executionMode": null,
      "policy": {
        "risk": "LOW",
        "executionMode": "MANUAL_ONLY",
        "networkDefault": false
      }
    },
    "actions.json": {
      "schema": "qp1ng.flow.v1",
      "nodes": [
        {
          "id": "input",
          "type": "input.selection",
          "config": {},
          "outputs": [
            {
              "id": "out",
              "targets": [
                "process:in"
              ]
            }
          ],
          "position": null
        },
        {
          "id": "process",
          "type": "process.python",
          "config": {
            "script": "import base64, re\ntext = base64.b64decode(\"{{selection.text.b64}}\").decode(\"utf-8\", \"replace\")\nrules = [\n    (r\"-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----\", \"[REDACTED_PRIVATE_KEY]\"),\n    (r\"\\b(?:sk|pk|ghp|xoxb|xoxp|AKIA)[A-Za-z0-9_\\-]{16,}\\b\", \"[REDACTED_TOKEN]\"),\n    (r\"\\b[0-9a-fA-F]{64}\\b\", \"[REDACTED_64_HEX]\"),\n    (r\"\\b\\d{4}[- ]?\\d{4}[- ]?\\d{4}[- ]?\\d{4}\\b\", \"[REDACTED_CARD_LIKE]\"),\n    (r\"\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b\", \"[REDACTED_EMAIL]\"),\n    (r\"\\b\\+?\\d[\\d .-]{8,}\\d\\b\", \"[REDACTED_PHONE]\"),\n]\nredacted = text\nhits = 0\nfor pattern, replacement in rules:\n    redacted, count = re.subn(pattern, replacement, redacted)\n    hits += count\nprint(\"SECRET REDACTOR\")\nprint(f\"Replacements: {hits}\")\nprint()\nprint(redacted[:12000] if redacted.strip() else \"No selected text.\")",
            "timeout": 30
          },
          "outputs": [
            {
              "id": "out",
              "targets": [
                "output:in"
              ]
            },
            {
              "id": "error",
              "targets": [
                "error:in"
              ]
            }
          ],
          "position": null
        },
        {
          "id": "output",
          "type": "output.chat_bubble",
          "config": {},
          "outputs": [],
          "position": null
        },
        {
          "id": "error",
          "type": "output.error",
          "config": {},
          "outputs": [],
          "position": null
        }
      ],
      "metadata": {
        "name": "Secret Redactor",
        "description": "Starter catalog tool.",
        "createdBy": "qp1ng-starter-catalog",
        "version": 1
      }
    },
    "bubble.json": {
      "schema": "qp1ng.bubble.v1",
      "title": "Secret Redactor",
      "style": "code_output",
      "language": "python",
      "showCommand": true,
      "showExitCode": true,
      "showRuntime": true,
      "showAddToChat": true
    }
  },
  "schema": "qp1ng.marketplace.package.v1",
  "kind": "tool",
  "version": 1,
  "scenario": null
}
