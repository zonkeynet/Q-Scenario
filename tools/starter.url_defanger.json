{
  "id": "starter.url_defanger",
  "name": "URL Defanger",
  "summary": "Turns selected links into safe shareable text for reports.",
  "category": "OPSEC utility",
  "risk": "LOW",
  "files": {
    "manifest.json": {
      "schema": "qp1ng.tool.v1",
      "id": "starter.url_defanger",
      "name": "URL Defanger",
      "version": "0.1.0",
      "author": "local",
      "category": "workspace",
      "description": "Turns selected links into safe shareable text for reports.",
      "icon": {
        "type": "auto",
        "glyph": "terminal",
        "accent": "cyan"
      },
      "permissions": {
        "sandboxExecution": true,
        "workspaceRead": false,
        "workspaceWrite": false,
        "network": false,
        "keyboardShortcut": true,
        "chatBubble": true,
        "androidAction": false,
        "securityLab": false
      },
      "network": null,
      "securityLab": null,
      "inputs": [
        {
          "name": "selection",
          "type": "template",
          "value": "{{selection.text}}",
          "required": false
        }
      ],
      "risk": null,
      "executionMode": null,
      "policy": {
        "risk": "LOW",
        "executionMode": "MANUAL_ONLY",
        "networkDefault": false
      }
    },
    "actions.json": {
      "schema": "qp1ng.flow.v1",
      "nodes": [
        {
          "id": "input",
          "type": "input.selection",
          "config": {},
          "outputs": [
            {
              "id": "out",
              "targets": [
                "process:in"
              ]
            }
          ],
          "position": null
        },
        {
          "id": "process",
          "type": "process.python",
          "config": {
            "script": "import base64, re\ntext = base64.b64decode(\"{{selection.text.b64}}\").decode(\"utf-8\", \"replace\")\ndefang = text.replace(\"http://\", \"hxxp://\").replace(\"https://\", \"hxxps://\")\ndefang = re.sub(r\"\\.\", \"[.]\", defang)\nprint(\"URL DEFANGER\")\nprint(defang.strip() if defang.strip() else \"No selected URL/text.\")",
            "timeout": 30
          },
          "outputs": [
            {
              "id": "out",
              "targets": [
                "output:in"
              ]
            },
            {
              "id": "error",
              "targets": [
                "error:in"
              ]
            }
          ],
          "position": null
        },
        {
          "id": "output",
          "type": "output.chat_bubble",
          "config": {},
          "outputs": [],
          "position": null
        },
        {
          "id": "error",
          "type": "output.error",
          "config": {},
          "outputs": [],
          "position": null
        }
      ],
      "metadata": {
        "name": "URL Defanger",
        "description": "Starter catalog tool.",
        "createdBy": "qp1ng-starter-catalog",
        "version": 1
      }
    },
    "bubble.json": {
      "schema": "qp1ng.bubble.v1",
      "title": "URL Defanger",
      "style": "code_output",
      "language": "python",
      "showCommand": true,
      "showExitCode": true,
      "showRuntime": true,
      "showAddToChat": true
    }
  },
  "schema": "qp1ng.marketplace.package.v1",
  "kind": "tool",
  "version": 1,
  "scenario": null
}
